{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laurenpembertonphotography",
"main": "worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "lauren-pemberton-photography",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
