{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laurenpembertonphotography",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "Photos",
      "bucket_name": "lauren-photography"
    }
  ],
  "assets": {
    "directory": "lauren-pemberton-photography",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
